REBEL_EMAIL=your_rebel_email
REBEL_PASSWORD=your_rebel_password
EMAIL_ADDRESS=your_gmail
EMAIL_PASSWORD=your_gmail_app_password

# --- fixwatch (skaner giełdy Betfair) ---
# betsapi = dane z Betfair przez BetsAPI (bez konta Betfair), betfair = bezpośrednio
DATA_SOURCE=betsapi
BETSAPI_TOKEN=your_betsapi_token
# tylko dla DATA_SOURCE=betfair:
BETFAIR_APP_KEY=your_betfair_app_key
BETFAIR_USERNAME=your_betfair_login
BETFAIR_PASSWORD=your_betfair_password
# opcjonalnie: logowanie certyfikatem (zalecane przez Betfair dla botów)
BETFAIR_CERT_FILE=
BETFAIR_KEY_FILE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 1 = wysyłaj też maila (EMAIL_ADDRESS / EMAIL_PASSWORD z góry)
ALERT_EMAIL=0
MIN_VOLUME=5000
RATE_RATIO_HIGH=1.7
RATE_RATIO_LOW=0.6
VOLUME_VS_MATCH_ODDS=2.0
GOALS_PER_90=2.6
# domyślnie 60 s dla BetsAPI, 30 s dla Betfair
SCAN_INTERVAL=
# dodatkowe ligi do pominięcia, po przecinku
EXCLUDED_COMPETITIONS=
